# Copy to .env locally. Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
JUDGE0_MODE=self-hosted
JUDGE0_URL=http://127.0.0.1:2358
# npm run dev supplies the generated local token. Set this for another private judge.
JUDGE0_AUTH_TOKEN=
# Hosted grading is opt-in: set JUDGE0_MODE=rapidapi and its URL/key/host.
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# Leave these unset for the local persistent H2 database.
# DATABASE_URL=jdbc:postgresql://localhost:5432/oneonone
# DATABASE_USERNAME=oneonone
# DATABASE_PASSWORD=
# Used by Docker Compose's PostgreSQL service, not local H2:
POSTGRES_PASSWORD=change-me
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_BASE_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
