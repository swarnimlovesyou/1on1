{
  "name": "1on1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/project.mjs setup",
    "doctor": "node scripts/project.mjs doctor",
    "dev": "node scripts/project.mjs dev",
    "dev:core": "node scripts/project.mjs dev --without-services",
    "dev:web": "vite --host 127.0.0.1",
    "services": "node scripts/project.mjs services",
    "stop": "node scripts/project.mjs stop",
    "stop:core": "node scripts/project.mjs stop --without-services",
    "verify": "node scripts/project.mjs verify",
    "verify:references": "python scripts/verify-references.py",
    "verify:live": "node scripts/verify-live.mjs",
    "backup": "node scripts/project.mjs backup",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --dir src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/source-serif-4": "^5.3.1",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.6",
    "@tanstack/react-query": "^5.80.0",
    "monaco-editor": "^0.52.2",
    "motion": "^12.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.10.1",
    "prettier-plugin-java": "^2.12.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.0"
  }
}
